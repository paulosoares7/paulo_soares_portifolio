{
  "name": "portfolio-academico",
  "private": true,
  "description": "Portfólio acadêmico + plataforma de aulas (monorepo com npm workspaces)",
  "workspaces": [
    "database",
    "packages/ui",
    "admin",
    "portfolio",
    "plataforma",
    "site"
  ],
  "scripts": {
    "db:setup": "npm run setup -w @portfolio/database",
    "db:up": "npm run db:up -w @portfolio/database",
    "db:down": "npm run db:down -w @portfolio/database",
    "admin:dev": "npm run dev -w @portfolio/admin",
    "portfolio:dev": "npm run dev -w @portfolio/portfolio",
    "plataforma:dev": "npm run dev -w @portfolio/plataforma",
    "site:dev": "npm run dev -w @portfolio/site"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true
  },
  "overrides": {
    "katex": "^0.19.1"
  }
}
