# Copie para .env e troque as senhas. O .env nunca é commitado.
# Use só letras e números nas senhas (elas entram na URL sem codificação).

# Usadas pelo docker-compose.yml na criação do container (só ambiente local)
MYSQL_ROOT_PASSWORD=troque-a-senha-root
MYSQL_USER=portfolio
MYSQL_PASSWORD=troque-a-senha
MYSQL_PORT=3306

# Conexão MySQL (local com docker-compose ou provedor gerenciado)
DATABASE_URL="mysql://portfolio:troque-a-senha@localhost:3306/portfolio"

# Banco temporário que o `prisma migrate dev` usa para comparar migrações.
# Só é necessário no ambiente de desenvolvimento.
SHADOW_DATABASE_URL="mysql://portfolio:troque-a-senha@localhost:3306/portfolio_shadow"

# Opcionais do scripts/backup.sh
# BACKUP_DIR=./backups
# BACKUP_RETENTION_DAYS=7
