# Copie para .env.local (nunca commitado). Só DATABASE_URL é obrigatória.

# Mesmo banco do projeto database (veja database/.env)
DATABASE_URL="mysql://portfolio:troque-a-senha@localhost:3306/portfolio"

# Endereço público deste portfólio (metadados e sitemap)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Plataforma de aulas (menu "Aulas", seção da home e ícone "Aulas").
# Vazia = plataforma ainda fora do ar: os links "Aulas" mostram a página
# "Aulas em desenvolvimento" (/aulas). Para ligar, ponha o endereço (em
# desenvolvimento: http://localhost:3002) e reinicie o app (ou publique de novo).
NEXT_PUBLIC_PLATAFORMA_URL=""

# E-mail de aviso de nova mensagem de contato (Resend). Vazio = a mensagem
# fica só no painel, sem aviso por e-mail.
RESEND_API_KEY=""
MAIL_FROM="Professor Paulo <nao-responda@seu-dominio.com>"

# Só em desenvolvimento: IP do computador na rede Wi-Fi, para abrir pelo
# celular (http://IP:PORTA). Descubra com "ipconfig" (Endereço IPv4 do Wi-Fi).
# O IP pode mudar quando o roteador reinicia: atualize aqui e reinicie o app.
DEV_HOST=""
