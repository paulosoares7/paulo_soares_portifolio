# Copie para .env.local (nunca commitado). Só DATABASE_URL é obrigatória para
# ver o catálogo; o login precisa também de BETTER_AUTH_SECRET.

# Mesmo banco do projeto database (veja database/.env)
DATABASE_URL="mysql://portfolio:troque-a-senha@localhost:3306/portfolio"

# Endereço público desta plataforma (metadados, sitemap, links dos e-mails)
NEXT_PUBLIC_SITE_URL="http://localhost:3002"

# Portfólio do professor (página "Sobre o professor", rodapé e contato)
NEXT_PUBLIC_PORTFOLIO_URL="http://localhost:3000"

# Login dos alunos (Better Auth)
# Segredo longo e aleatório (assina o cookie da sessão e criptografa os tokens
# do Google). Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Trocar o segredo derruba todas as sessões. O admin usa o MESMO valor.
BETTER_AUTH_SECRET=""
# Endereço desta plataforma (em produção, o domínio com https://)
BETTER_AUTH_URL="http://localhost:3002"

# Entrar com Google (Google Cloud > APIs e serviços > Credenciais > ID do
# cliente OAuth, tipo "Aplicativo da Web"). Vazio = o botão do Google some.
# URI de redirecionamento autorizado:
#   desenvolvimento: http://localhost:3002/api/auth/callback/google
#   produção:        https://SEU-DOMINIO/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Asaas (use o sandbox até a fase 4 ser aprovada)
ASAAS_API_URL="https://api-sandbox.asaas.com/v3"
ASAAS_API_KEY=""
ASAAS_WEBHOOK_TOKEN=""

# Bunny Stream (URL assinada do player)
BUNNY_LIBRARY_ID=""
BUNNY_TOKEN_KEY=""

# Storage de PDFs (URL assinada de curta duração)
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# E-mail (Resend): confirmação de cadastro e redefinição de senha.
# Vazio em desenvolvimento = os links aparecem no terminal do "npm run dev".
RESEND_API_KEY=""
MAIL_FROM="Professor Paulo <nao-responda@seu-dominio.com>"

# Vercel Cron
CRON_SECRET=""
