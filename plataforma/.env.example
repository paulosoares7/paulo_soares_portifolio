# Copie para .env.local (nunca commitado). Só DATABASE_URL é obrigatória para
# ver o catálogo; o login precisa também de BETTER_AUTH_SECRET.

# Mesmo banco do projeto database (veja database/.env)
DATABASE_URL="mysql://portfolio:troque-a-senha@localhost:3306/portfolio"

# Endereço público desta plataforma (metadados, sitemap, links dos e-mails)
NEXT_PUBLIC_SITE_URL="http://localhost:3002"

# Portfólio do professor (página "Sobre o professor", rodapé e contato)
NEXT_PUBLIC_PORTFOLIO_URL="http://localhost:3000"

# Asaas (use o sandbox até a fase 4 ser aprovada)
ASAAS_API_URL="https://api-sandbox.asaas.com/v3"
ASAAS_API_KEY=""
ASAAS_WEBHOOK_TOKEN=""

# Bunny Stream (URL assinada do player)
BUNNY_LIBRARY_ID=""
BUNNY_TOKEN_KEY=""

# Storage de PDFs (URL assinada de curta duração)
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# E-mail (Resend)
RESEND_API_KEY=""
