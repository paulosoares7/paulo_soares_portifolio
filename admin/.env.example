# Copie para .env.local (nunca commitado). Só DATABASE_URL é obrigatória:
# sem as demais, o painel funciona e mostra o que falta configurar.

# Mesmo banco do projeto database (veja database/.env)
DATABASE_URL="mysql://portfolio:troque-a-senha@localhost:3306/portfolio"

# Reservada: a sessão do admin usa token aleatório + SHA-256 no banco e não
# depende desta chave hoje.
SESSION_SECRET="gere-uma-string-aleatoria-longa"

# Endereço deste painel (link do "Esqueci a senha"). Em produção, com https://
ADMIN_URL="http://localhost:3001"

# Plataforma de aulas: o botão "Enviar link de senha" da página do aluno gera o
# link pelo Better Auth, com o MESMO segredo da plataforma.
PLATAFORMA_URL="http://localhost:3002"
BETTER_AUTH_SECRET=""

# Bunny Stream (vídeos pagos). Painel do Bunny > Stream > sua biblioteca > API.
BUNNY_LIBRARY_ID=""
BUNNY_API_KEY=""

# Storage de PDFs e imagens (S3 compatível: Cloudflare R2, Backblaze B2, AWS S3...)
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
# URL pública do bucket para arquivos públicos (foto do perfil, capas).
# Ex.: https://pub-xxxx.r2.dev  (vazio = arquivos públicos usam URL assinada)
STORAGE_PUBLIC_URL=""

# Asaas (consulta de assinaturas e cobranças)
ASAAS_API_URL="https://api-sandbox.asaas.com/v3"
ASAAS_API_KEY=""

# ORCID (genérico até ter o iD; o perfil no painel tem prioridade)
ORCID_ID="0000-0000-0000-0000"

# E-mail (Resend): links de senha do admin e dos alunos.
# Vazio em desenvolvimento = os links aparecem no terminal do "npm run dev".
RESEND_API_KEY=""
MAIL_FROM="Professor Paulo <nao-responda@seu-dominio.com>"

# Só em desenvolvimento: IP do computador na rede Wi-Fi, para abrir pelo
# celular (http://IP:PORTA). Descubra com "ipconfig" (Endereço IPv4 do Wi-Fi).
# O IP pode mudar quando o roteador reinicia: atualize aqui e reinicie o app.
DEV_HOST=""
